<view class="page"><view class="title">{{form.id ? '记录详情' : '记下这一次用车'}}</view><view class="subtitle">{{vehicle.name}}</view><view class="notice" wx:if="{{vehicle.archived}}">此车辆已归档；恢复车辆后可修改或删除记录。</view><view class="notice" wx:if="{{planName}}">关联计划：{{planName}}。保存后按实际完成日期与里程更新计划。</view>
<view class="field"><view class="label">记录类型 *</view><view class="filters"><button wx:for="{{kinds}}" wx:key="id" class="filter {{kindIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="pickKind">{{item.name}}</button></view></view>
<view class="field" id="f-date"><view class="label">发生日期 *</view><picker mode="date" value="{{form.date}}" end="{{today}}" data-field="date" bindchange="input"><view class="picker {{errorField === 'date' ? 'invalid' : ''}}">{{form.date}} ▾</view></picker><view class="field-error" wx:if="{{errorField === 'date'}}">{{error}}</view></view><view class="field" id="f-mileage"><view class="label">累计里程 · km{{form.kind === 'other' && !form.planId ? '（选填）' : ' *'}}</view><input class="input {{errorField === 'mileage' ? 'invalid' : ''}}" type="number" value="{{form.mileage}}" data-field="mileage" bindinput="input" placeholder="{{mileageHint}}"/><view class="field-error" wx:if="{{errorField === 'mileage'}}">{{error}}</view></view><view class="field" id="f-amount"><view class="label">实付金额 · 元 *</view><input class="input {{errorField === 'amount' ? 'invalid' : ''}}" type="digit" value="{{form.amount}}" data-field="amount" bindinput="input" placeholder="0.00，免费项目可填 0"/><view class="field-error" wx:if="{{errorField === 'amount'}}">{{error}}</view></view>
<view class="field" wx:if="{{form.kind === 'other'}}"><view class="label">费用类别</view><view class="filters"><button wx:for="{{categories}}" wx:key="*this" class="filter {{form.category === item ? 'active' : ''}}" data-value="{{item}}" bindtap="pickCategory">{{item}}</button></view></view>
<block wx:if="{{form.kind === 'fuel' || form.kind === 'charge'}}"><view class="field"><view class="label">单价 · {{form.kind === 'fuel' ? '元/L' : '元/kWh'}}（选填）</view><input class="input" type="digit" value="{{form.price}}" data-field="price" bindinput="input" placeholder="填写金额和单价，可自动算出{{form.kind === 'fuel' ? '加油量' : '电量'}}"/></view><view class="field" id="f-quantity"><view class="label">{{form.kind === 'fuel' ? '加油量 · L' : '账单充入电量 · kWh'}} *</view><input class="input {{errorField === 'quantity' ? 'invalid' : ''}}" type="digit" value="{{form.quantity}}" data-field="quantity" bindinput="input" placeholder="请输入实际补能量"/><view class="field-error" wx:if="{{errorField === 'quantity'}}">{{error}}</view></view></block>
<block wx:if="{{form.kind === 'fuel'}}"><view class="switch-row"><view><view>本次已加满</view><view class="tiny">两次加满之间可以算出油耗</view></view><switch color="#065f46" checked="{{form.full}}" data-field="full" bindchange="toggle"/></view><view class="switch-row"><view><view>期间存在漏记</view><view class="tiny">上次加油后有加油没记下来，这一段不计油耗</view></view><switch color="#065f46" checked="{{form.gap}}" data-field="gap" bindchange="toggle"/></view></block>
<block wx:if="{{form.kind === 'charge'}}"><view class="field" id="f-socAfter"><view class="label">充电后电量 · %（选填，算电耗需要）</view><input class="input {{errorField === 'socAfter' ? 'invalid' : ''}}" type="number" value="{{form.socAfter}}" data-field="socAfter" bindinput="input" placeholder="{{socHint}}"/><view class="field-error" wx:if="{{errorField === 'socAfter'}}">{{error}}</view></view><view class="switch-row"><view><view>上次以来的充电都已记录</view><view class="tiny">包括在其他地方的充电；不确定就关闭，费用照常统计</view></view><switch color="#065f46" checked="{{form.confirmed}}" data-field="confirmed" bindchange="toggle"/></view><view class="tiny">两次充电后电量相同，且中间的充电都已记录，才能算出电耗。</view></block>
<view class="field"><view class="label">项目 / 备注（选填）</view><input class="input" value="{{form.note}}" maxlength="120" data-field="note" bindinput="input" placeholder="例如：92 号汽油、家充、机油机滤"/></view><view class="error" wx:if="{{error && !errorField}}">{{error}}</view><button class="primary" loading="{{saving}}" disabled="{{saving || !ready || vehicle.archived}}" bindtap="save">保存记录</button><button wx:if="{{form.id}}" class="danger spaced" disabled="{{vehicle.archived}}" bindtap="remove">删除这笔记录</button><view class="footer-note">支持历史补录。日期与里程必须和相邻日期记录一致；同一天内按里程排序。未关联计划的其他费用可不填里程。</view></view>
