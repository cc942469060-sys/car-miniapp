<view class="page"><view class="title">{{form.id ? '记录详情' : '记下这一次用车'}}</view><view class="subtitle">{{vehicle.name}}</view><view class="notice" wx:if="{{vehicle.archived}}">此车辆已归档；恢复车辆后可修改记录。</view><view class="notice" wx:if="{{planName}}">关联计划：{{planName}}。保存后按实际完成日期与里程更新计划。</view>
<view class="field"><view class="label">记录类型 *</view><picker range="{{kinds}}" range-key="name" value="{{kindIndex}}" disabled="{{!!form.planId}}" bindchange="kindChange"><view class="picker">{{kinds[kindIndex].name}} ▾</view></picker></view>
<view class="field"><view class="label">发生日期 *</view><picker mode="date" value="{{form.date}}" end="{{today}}" data-field="date" bindchange="input"><view class="picker">{{form.date}} ▾</view></picker></view><view class="field"><view class="label">累计里程 · km *</view><input class="input" type="number" value="{{form.mileage}}" data-field="mileage" bindinput="input" placeholder="仪表显示的累计里程"/></view><view class="field"><view class="label">实付金额 · 元 *</view><input class="input" type="digit" value="{{form.amount}}" data-field="amount" bindinput="input" placeholder="0.00，免费项目可填 0"/></view>
<block wx:if="{{form.kind === 'fuel' || form.kind === 'charge'}}"><view class="field"><view class="label">{{form.kind === 'fuel' ? '加油量 · L' : '账单充入电量 · kWh'}} *</view><input class="input" type="digit" value="{{form.quantity}}" data-field="quantity" bindinput="input" placeholder="请输入实际补能量"/></view><view class="switch-row" wx:if="{{form.kind === 'fuel'}}"><text>本次已加满</text><switch color="#065f46" checked="{{form.full}}" data-field="full" bindchange="toggle"/></view><view class="switch-row"><view><view>期间存在漏记</view><view class="tiny">从上次同类补能记录到本次</view></view><switch color="#065f46" checked="{{form.gap}}" data-field="gap" bindchange="toggle"/></view></block>
<block wx:if="{{form.kind === 'charge'}}"><view class="field"><view class="label">充电后电量 · %（选填）</view><input class="input" type="number" value="{{form.socAfter}}" data-field="socAfter" bindinput="input" placeholder="0—100，用于比较区间边界"/></view><view class="switch-row"><view><view>确认本段充电记录完整</view><view class="tiny">包含上次充电记录之后的所有外部补能</view></view><switch color="#065f46" checked="{{form.confirmed}}" data-field="confirmed" bindchange="toggle"/></view><view class="tiny">只有起止充电后电量相同且记录完整，才计算充电侧电耗。否则仍可统计费用。</view></block>
<view class="field"><view class="label">项目 / 备注（选填）</view><input class="input" value="{{form.note}}" maxlength="120" data-field="note" bindinput="input" placeholder="例如：92 号汽油、家充、机油机滤"/></view><view class="error" wx:if="{{error}}">{{error}}</view><button class="primary" loading="{{saving}}" disabled="{{saving || !ready || vehicle.archived}}" bindtap="save">保存记录</button><button wx:if="{{form.id}}" class="danger spaced" bindtap="remove">删除这笔记录</button><view class="footer-note">支持历史补录。日期与里程必须和相邻日期记录一致；同一天内按里程排序。</view></view>
