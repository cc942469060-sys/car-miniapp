<import src="../../templates/shared.wxml"/>
<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><template wx:if="{{!vehicle && !error}}" is="onboarding"/><block wx:if="{{vehicle}}"><template is="vehicle-switch" data="{{vehicle,vehicles,vehicleIndex}}"/><view class="title">用车账本</view><picker mode="date" fields="month" value="{{month}}" end="{{today}}" bindchange="monthChange"><view class="picker">{{month}} ▾ · {{count}} 笔 · ¥{{amount}}</view></picker><view class="filters"><button wx:for="{{filters}}" wx:key="id" class="filter {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterChange">{{item.name}}</button></view><view class="card" wx:if="{{records.length}}"><template is="records" data="{{records}}"/></view><view wx:else class="empty"><view class="muted">本月还没有这一类记录</view></view><button class="primary" bindtap="addRecord" disabled="{{vehicle.archived}}">＋ 记一笔</button><view class="footer-note">点击记录可查看、编辑或删除。月度合计包括所有费用类型，仅代表已记支出。</view></block></view>
