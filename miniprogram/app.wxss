px}.danger{color:#b91c1c;background:#fff1f2}.section{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 18rpx;gap:16rpx}.section-title{font-size:30rpx;font-weight:600}.row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #e7e5e4}.row:last-child{border-bottom:0}.row-main{flex:1;min-width:0}.row-title{font-size:27rpx;font-weight:600;word-break:break-all}.row-meta{font-size:23rpx;color:#57534e;margin-top:6rpx;word-break:break-all}.row-price{font-size:28rpx;font-weight:600;font-variant-numeric:tabular-nums}.symbol{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;background:#f5f5f4;color:#065f46;border-radius:22rpx;font-weight:600;flex-shrink:0}.notice{background:#ecfdf5;color:#065f46;padding:22rpx 26rpx;border-left:6rpx solid #a7f3d0;font-size:24rpx;line-height:1.8;margin:24rpx 0}.empty{text-align:center;padding:70rpx 20rpx}.empty-title{font-size:34rpx;font-weight:600;margin-bottom:18rpx}.empty .primary{margin-top:32rpx}.error{color:#b91c1c;background:#fff1f2;padding:20rpx;border-radius:16rpx;margin:20rpx 0;font-size:25rpx;word-break:break-all}.filters{display:flex;flex-wrap:wrap;gap:14rpx;margin:24rpx 0}.filter{background:white;border:1rpx solid #e7e5e4;color:#57534e;font-size:24rpx;padding:16rpx 24rpx;border-radius:18rpx}.filter.active{background:#065f46;color:white;border-color:#065f46}.field{margin:28rpx 0}.label{font-size:25rpx;color:#44403c;margin-bottom:12rpx}.input,.picker{border:1rpx solid #d6d3d1;border-radius:20rpx;background:white;min-height:88rpx;padding:20rpx 22rpx;font-size:28rpx;width:100%}.input{height:88rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0}.actions{display:flex;gap:16rpx;margin-top:20rpx}.actions button{flex:1}.badge{font-size:22rpx;border-radius:12rpx;background:#f5f5f4;color:#57534e;padding:6rpx 12rpx}.badge.urgent{color:#b91c1c;background:#fff1f2}.plan-title{display:flex;justify-content:space-b